# Copy this file to .env and replace placeholder values as needed.

GEMINI_API_KEY=<your-key-here>
GROQ_API_KEY=<your-key-here>
MISTRAL_API_KEY=<your-key-here>
OPENROUTER_API_KEY=<your-key-here>
OPENROUTER_MODELS=qwen/qwen3-coder:free
MODEL_EXECUTION_TIMEOUT_SECONDS=120

# AI Code Review uses a separate reviewer account and key.
AI_REVIEW_PROVIDER=mock
AI_REVIEW_OPENROUTER_API_KEY=<your-key-here>
AI_REVIEW_MODELS=openai/gpt-oss-20b:free,cohere/north-mini-code:free
AI_REVIEW_TIMEOUT_SECONDS=120
AI_REVIEW_MAX_OUTPUT_TOKENS=1800
AI_REVIEW_MAX_INPUT_CHARS=60000
AI_REVIEW_PROMPT_VERSION=ai-code-review-v1
AI_REVIEW_RUBRIC_VERSION=ai-code-review-rubric-v1
